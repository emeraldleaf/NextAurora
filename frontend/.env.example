# Copy to .env.local (gitignored) and fill from the Aspire dashboard's Resources tab —
# service ports + Keycloak URL are dynamic per Aspire run (same convention as .env.smoke).
VITE_CATALOG_API_URL=http://localhost:5301
VITE_ORDER_API_URL=http://localhost:5302
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=nextaurora
VITE_KEYCLOAK_CLIENT_ID=storefront
