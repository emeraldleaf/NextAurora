    {
      "type": "rectangle", "id": "w_sql", "x": 780, "y": 334, "width": 700, "height": 130,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300009, "version": 1, "versionNonce": 300010,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"w_sql_t","type":"text"},{"id":"a_w_2","type":"arrow"}], "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "w_sql_t", "x": 790, "y": 348, "width": 680, "height": 100,
      "text": "// EF emits UPDATE with concurrency-token check in WHERE\n\nPostgres (Npgsql):     UPDATE \"Products\" SET \"Name\" = @p0, \"Price\" = @p1, \"UpdatedAt\" = @p2\n                       WHERE \"Id\" = @p3 AND xmin = @p4;\n\nSQL Server (SqlClient): UPDATE [Products] SET [Name] = @p0, [Price] = @p1, [UpdatedAt] = @p2\n                        OUTPUT INSERTED.[RowVersion] WHERE [Id] = @p3 AND [RowVersion] = @p4;",
      "originalText": "// EF emits UPDATE with concurrency-token check in WHERE\n\nPostgres (Npgsql):     UPDATE \"Products\" SET \"Name\" = @p0, \"Price\" = @p1, \"UpdatedAt\" = @p2\n                       WHERE \"Id\" = @p3 AND xmin = @p4;\n\nSQL Server (SqlClient): UPDATE [Products] SET [Name] = @p0, [Price] = @p1, [UpdatedAt] = @p2\n                        OUTPUT INSERTED.[RowVersion] WHERE [Id] = @p3 AND [RowVersion] = @p4;",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300011, "version": 1, "versionNonce": 300012,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "w_sql", "lineHeight": 1.3
    },

