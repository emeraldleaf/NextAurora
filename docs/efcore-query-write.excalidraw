    {
      "type": "text",
      "id": "subtitle",
      "x": 39.79988374149127,
      "y": 80,
      "width": 1691.015625,
      "height": 33.800000000000004,
      "text": "READ:  LINQ → expression tree → provider-specific SQL → DataReader → DTO  (no tracker, no entity allocation).\nWRITE:  load tracked → mutate via domain method → SaveChanges → UPDATE ... WHERE Id=@p AND xmin/RowVersion=@orig  (concurrency check). 0 rows matched → DbUpdateConcurrencyException → 409 (HTTP) or Wolverine retry (events).",
      "originalText": "READ:  LINQ → expression tree → provider-specific SQL → DataReader → DTO  (no tracker, no entity allocation).\nWRITE:  load tracked → mutate via domain method → SaveChanges → UPDATE ... WHERE Id=@p AND xmin/RowVersion=@orig  (concurrency check). 0 rows matched → DbUpdateConcurrencyException → 409 (HTTP) or Wolverine retry (events).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
