    {
      "type": "text", "id": "r_sql_t", "x": 50, "y": 422, "width": 680, "height": 62,
      "text": "Provider-specific SQL generation:\n  Postgres (Npgsql):    SELECT p.\"Id\", p.\"Name\", p.\"Price\", ... FROM \"Products\" p WHERE p.\"Id\" = @__id_0 LIMIT 1\n  SQL Server (SqlClient): SELECT TOP(1) [p].[Id], [p].[Name], [p].[Price], ... FROM [Products] AS [p] WHERE [p].[Id] = @__id_0",
      "originalText": "Provider-specific SQL generation:\n  Postgres (Npgsql):    SELECT p.\"Id\", p.\"Name\", p.\"Price\", ... FROM \"Products\" p WHERE p.\"Id\" = @__id_0 LIMIT 1\n  SQL Server (SqlClient): SELECT TOP(1) [p].[Id], [p].[Name], [p].[Price], ... FROM [Products] AS [p] WHERE [p].[Id] = @__id_0",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200017, "version": 1, "versionNonce": 200018,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "r_sql", "lineHeight": 1.3
