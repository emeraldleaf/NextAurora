    {
      "type": "rectangle", "id": "w_load", "x": 780, "y": 200, "width": 700, "height": 100,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300003, "version": 1, "versionNonce": 300004,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"w_load_t","type":"text"},{"id":"a_w_1","type":"arrow"}], "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "w_load_t", "x": 790, "y": 215, "width": 680, "height": 70,
      "text": "var product = await ctx.Products.FirstAsync(p => p.Id == id);     // tracked\n// change tracker stores: { Id, Name, Price, ..., xmin = 12345 (or RowVersion = 0x00000000000007D1) }\nproduct.UpdateDetails(name, description, price);                  // mutate via domain method\nawait ctx.SaveChangesAsync();",
      "originalText": "var product = await ctx.Products.FirstAsync(p => p.Id == id);     // tracked\n// change tracker stores: { Id, Name, Price, ..., xmin = 12345 (or RowVersion = 0x00000000000007D1) }\nproduct.UpdateDetails(name, description, price);                  // mutate via domain method\nawait ctx.SaveChangesAsync();",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300005, "version": 1, "versionNonce": 300006,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "w_load", "lineHeight": 1.3
    },

    {
      "type": "arrow", "id": "a_w_1", "x": 1130, "y": 302, "width": 0, "height": 30,
      "strokeColor": "#1e3a5f", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300007, "version": 1, "versionNonce": 300008,
