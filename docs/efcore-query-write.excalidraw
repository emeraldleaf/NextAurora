    {
      "type": "text", "id": "token_t", "x": 60, "y": 785, "width": 620, "height": 28,
      "text": "Concurrency tokens — different mechanisms per provider",
      "originalText": "Concurrency tokens — different mechanisms per provider",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#5b21b6", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500003, "version": 1, "versionNonce": 500004,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "token_panel", "lineHeight": 1.25
    },
    {
      "type": "text", "id": "token_body", "x": 60, "y": 820, "width": 620, "height": 180,
      "text": "POSTGRES — xmin  (Catalog, Shipping)\n  ▸ System column on every row; engine auto-increments on every write\n  ▸ NO schema change required — just bind to it as a shadow property:\n     entity.Property<uint>(\"xmin\").HasColumnName(\"xmin\").HasColumnType(\"xid\")\n          .ValueGeneratedOnAddOrUpdate().IsConcurrencyToken();\n  ▸ Old API UseXminAsConcurrencyToken() removed in Npgsql 9+ — manual form is canonical\n\nSQL SERVER — RowVersion  (Order, Payment)\n  ▸ Real rowversion column the engine maintains on insert/update\n  ▸ REQUIRES a migration to add the column\n  ▸ entity.Property<byte[]>(\"RowVersion\").IsRowVersion();",
      "originalText": "POSTGRES — xmin  (Catalog, Shipping)\n  ▸ System column on every row; engine auto-increments on every write\n  ▸ NO schema change required — just bind to it as a shadow property:\n     entity.Property<uint>(\"xmin\").HasColumnName(\"xmin\").HasColumnType(\"xid\")\n          .ValueGeneratedOnAddOrUpdate().IsConcurrencyToken();\n  ▸ Old API UseXminAsConcurrencyToken() removed in Npgsql 9+ — manual form is canonical\n\nSQL SERVER — RowVersion  (Order, Payment)\n  ▸ Real rowversion column the engine maintains on insert/update\n  ▸ REQUIRES a migration to add the column\n  ▸ entity.Property<byte[]>(\"RowVersion\").IsRowVersion();",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500005, "version": 1, "versionNonce": 500006,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },

