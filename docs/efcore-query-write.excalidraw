    {
      "type": "text", "id": "r_result_t", "x": 50, "y": 640, "width": 680, "height": 62,
      "text": "Materialize DIRECTLY into ProductDto.\nNO Product entity is constructed.  NO identity-map entry.  NO change-tracking snapshot.\nWhy this matters: at high RPS, the saved allocations are measurable in GC pressure.",
      "originalText": "Materialize DIRECTLY into ProductDto.\nNO Product entity is constructed.  NO identity-map entry.  NO change-tracking snapshot.\nWhy this matters: at high RPS, the saved allocations are measurable in GC pressure.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#065f46", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200029, "version": 1, "versionNonce": 200030,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "r_result", "lineHeight": 1.3
    },

    {
      "type": "text", "id": "write_col_title", "x": 780, "y": 160, "width": 700, "height": 28,
      "text": "WRITE PATH  ▸  load tracked → mutate → SaveChanges → concurrency check",
