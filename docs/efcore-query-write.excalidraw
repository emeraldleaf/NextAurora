    {
      "type": "text",
      "id": "r_result_t",
      "x": 50,
      "y": 640,
      "width": 680,
      "height": 62,
      "text": "Materialize DIRECTLY into ProductDto.\nNO Product entity is constructed.  NO identity-map entry.  NO change-tracking snapshot.\nWhy this matters: at high RPS, the saved allocations are measurable in GC pressure.",
      "originalText": "Materialize DIRECTLY into ProductDto.\nNO Product entity is constructed.  NO identity-map entry.  NO change-tracking snapshot.\nWhy this matters: at high RPS, the saved allocations are measurable in GC pressure.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#065f46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
