      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"r_linq_t","type":"text"},{"id":"a_r_1","type":"arrow"}], "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "r_linq_t", "x": 50, "y": 215, "width": 680, "height": 50,
      "text": "var dto = await ctx.Products.AsNoTracking()\n   .Where(p => p.Id == id)\n   .Select(p => new ProductDto { Id = p.Id, Name = p.Name, Price = p.Price, ... }).FirstOrDefaultAsync(ct);",
      "originalText": "var dto = await ctx.Products.AsNoTracking()\n   .Where(p => p.Id == id)\n   .Select(p => new ProductDto { Id = p.Id, Name = p.Name, Price = p.Price, ... }).FirstOrDefaultAsync(ct);",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200005, "version": 1, "versionNonce": 200006,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "r_linq", "lineHeight": 1.3
