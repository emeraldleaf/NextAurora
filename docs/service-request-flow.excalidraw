    {
      "type": "text",
      "id": "step_handler_t",
      "x": 390,
      "y": 1058,
      "width": 240,
      "height": 38,
      "text": "Handler.HandleAsync\n(domain logic + repo calls)",
      "originalText": "Handler.HandleAsync\n(domain logic + repo calls)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 200071,
      "version": 2,
      "versionNonce": 1910748460,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "containerId": "step_handler",
      "lineHeight": 1.25,
      "index": "ab",
