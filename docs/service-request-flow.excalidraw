    {
      "type": "text",
      "id": "ann_cor",
      "x": 680,
      "y": 270,
      "width": 745.3125,
      "height": 46.800000000000004,
      "text": "Reads X-Correlation-Id (or generates from trace ID), X-User-Id (JWT sub claim), X-Session-Id from headers.\nSets Activity.Current baggage AND opens logger.BeginScope() — every log line emitted anywhere downstream \nautomatically carries CorrelationId / UserId / SessionId.",
      "originalText": "Reads X-Correlation-Id (or generates from trace ID), X-User-Id (JWT sub claim), X-Session-Id from headers.\nSets Activity.Current baggage AND opens logger.BeginScope() — every log line emitted anywhere downstream \nautomatically carries CorrelationId / UserId / SessionId.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
