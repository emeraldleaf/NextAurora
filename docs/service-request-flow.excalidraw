    {
      "type": "text", "id": "step_db_t", "x": 390, "y": 1165, "width": 240, "height": 50,
      "text": "Repository.UpdateAsync\n→ DbContext.SaveChangesAsync\n(entity write + outbox row)",
      "originalText": "Repository.UpdateAsync\n→ DbContext.SaveChangesAsync\n(entity write + outbox row)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#ffffff", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200079, "version": 1, "versionNonce": 200080,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": "step_db", "lineHeight": 1.25
    },
    {
      "type": "text", "id": "ann_db", "x": 680, "y": 1150, "width": 480, "height": 80,
      "text": "Repository implementation calls context.SaveChangesAsync(). EF generates UPDATE ... WHERE Id=@id AND RowVersion=@orig (SQL Server) or AND xmin=@orig (Postgres) — concurrency token in the WHERE clause.\nIf the handler also called bus.PublishAsync(event), Wolverine staged the event in wolverine.outgoing_envelopes in the SAME transaction.",
      "originalText": "Repository implementation calls context.SaveChangesAsync(). EF generates UPDATE ... WHERE Id=@id AND RowVersion=@orig (SQL Server) or AND xmin=@orig (Postgres) — concurrency token in the WHERE clause.\nIf the handler also called bus.PublishAsync(event), Wolverine staged the event in wolverine.outgoing_envelopes in the SAME transaction.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200081, "version": 1, "versionNonce": 200082,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },

