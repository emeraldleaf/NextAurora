    },
    {
      "type": "text", "id": "ann_auth", "x": 680, "y": 490, "width": 480, "height": 80,
      "text": ".RequireAuthorization() at the route group validates the JWT signature/issuer/audience.\nEach handler ALSO checks JWT.sub == command.BuyerId — prevents authenticated user A from submitting orders as user B. 403 Forbid if mismatch.",
      "originalText": ".RequireAuthorization() at the route group validates the JWT signature/issuer/audience.\nEach handler ALSO checks JWT.sub == command.BuyerId — prevents authenticated user A from submitting orders as user B. 403 Forbid if mismatch.",
