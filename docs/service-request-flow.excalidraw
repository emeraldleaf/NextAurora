    {
      "type": "text",
      "id": "ann_auth",
      "x": 680,
      "y": 490,
      "width": 464.0625,
      "height": 78,
      "text": ".RequireAuthorization() at the route group validates the JWT \nsignature/issuer/audience.\nEach handler ALSO checks JWT.sub == command.BuyerId \n— prevents authenticated user A from submitting orders as user B. \n  403 Forbid if mismatch.",
      "originalText": ".RequireAuthorization() at the route group validates the JWT \nsignature/issuer/audience.\nEach handler ALSO checks JWT.sub == command.BuyerId \n— prevents authenticated user A from submitting orders as user B. \n  403 Forbid if mismatch.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
