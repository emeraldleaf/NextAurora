    {
      "type": "text", "id": "pipe_tx_t", "x": 370, "y": 933, "width": 280, "height": 45,
      "text": "3. AutoApplyTransactions\n(opens EF DbContext transaction)",
      "originalText": "3. AutoApplyTransactions\n(opens EF DbContext transaction)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
