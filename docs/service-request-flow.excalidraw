    {
      "type": "text", "id": "ann_route", "x": 680, "y": 380, "width": 480, "height": 60,
      "text": "Helper from NextAurora.ServiceDefaults wraps NewVersionedApi + MapGroup + HasApiVersion(1,0) + WithTags.\nThe version segment is REQUIRED (AssumeDefaultVersionWhenUnspecified = false) — /api/products without v1 returns 400.",
      "originalText": "Helper from NextAurora.ServiceDefaults wraps NewVersionedApi + MapGroup + HasApiVersion(1,0) + WithTags.\nThe version segment is REQUIRED (AssumeDefaultVersionWhenUnspecified = false) — /api/products without v1 returns 400.",
