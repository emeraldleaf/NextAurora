    {
      "type": "text",
      "id": "ann_route",
      "x": 680,
      "y": 380,
      "width": 520.3125,
      "height": 78,
      "text": "Helper from NextAurora.ServiceDefaults wraps NewVersionedApi + MapGroup + \nHasApiVersion(1,0) + WithTags.\nThe version segment is REQUIRED \n(AssumeDefaultVersionWhenUnspecified = false) \n— /api/products without v1 returns 400.",
      "originalText": "Helper from NextAurora.ServiceDefaults wraps NewVersionedApi + MapGroup + \nHasApiVersion(1,0) + WithTags.\nThe version segment is REQUIRED \n(AssumeDefaultVersionWhenUnspecified = false) \n— /api/products without v1 returns 400.",
