    {
      "type": "text", "id": "step_cor_t", "x": 390, "y": 288, "width": 240, "height": 38,
      "text": "CorrelationIdMiddleware\n(ServiceDefaults)",
      "originalText": "CorrelationIdMiddleware\n(ServiceDefaults)",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200009, "version": 1, "versionNonce": 200010,
      "isDeleted": false, "groupIds": [], "boundElements": null,
