    {
      "type": "text", "id": "ann_cor", "x": 680, "y": 270, "width": 480, "height": 80,
      "text": "Reads X-Correlation-Id (or generates from trace ID), X-User-Id (JWT sub claim), X-Session-Id from headers.\nSets Activity.Current baggage AND opens logger.BeginScope() — every log line emitted anywhere downstream automatically carries CorrelationId / UserId / SessionId.",
      "originalText": "Reads X-Correlation-Id (or generates from trace ID), X-User-Id (JWT sub claim), X-Session-Id from headers.\nSets Activity.Current baggage AND opens logger.BeginScope() — every log line emitted anywhere downstream automatically carries CorrelationId / UserId / SessionId.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200011, "version": 1, "versionNonce": 200012,
