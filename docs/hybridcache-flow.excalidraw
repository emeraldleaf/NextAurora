    {
      "type": "rectangle", "id": "w_invalidate", "x": 760, "y": 418, "width": 320, "height": 90,
      "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300015, "version": 1, "versionNonce": 300016,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"w_invalidate_t","type":"text"}], "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "w_invalidate_t", "x": 770, "y": 432, "width": 300, "height": 62,
      "text": "cache.InvalidateAsync(productId)\n→ cache.RemoveByTagAsync(\"product:{guid}\")\n\nClears L2 + THIS replica's L1.",
      "originalText": "cache.InvalidateAsync(productId)\n→ cache.RemoveByTagAsync(\"product:{guid}\")\n\nClears L2 + THIS replica's L1.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#5b21b6", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300017, "version": 1, "versionNonce": 300018,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "w_invalidate", "lineHeight": 1.3
    },

    {
      "type": "text", "id": "w_order", "x": 760, "y": 524, "width": 320, "height": 36,
      "text": "ORDERING MATTERS:\ninvalidate AFTER the save, not before.",
      "originalText": "ORDERING MATTERS:\ninvalidate AFTER the save, not before.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#b45309", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300019, "version": 1, "versionNonce": 300020,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "w_order_why", "x": 760, "y": 570, "width": 320, "height": 100,
      "text": "If you invalidate first, a concurrent reader sees the stale row → repopulates the cache with the OLD value → your save commits → cache is now stale for the L1 TTL.\n\nInvalidate AFTER save closes that window. The 5-min TTL is only the safety net.",
      "originalText": "If you invalidate first, a concurrent reader sees the stale row → repopulates the cache with the OLD value → your save commits → cache is now stale for the L1 TTL.\n\nInvalidate AFTER save closes that window. The 5-min TTL is only the safety net.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300021, "version": 1, "versionNonce": 300022,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },

    {
      "type": "rectangle", "id": "caveat", "x": 760, "y": 700, "width": 700, "height": 200,
      "strokeColor": "#b91c1c", "backgroundColor": "#fee2e2",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400001, "version": 1, "versionNonce": 400002,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"caveat_title","type":"text"}], "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "caveat_title", "x": 770, "y": 715, "width": 680, "height": 28,
      "text": "⚠ Multi-replica L1 invalidation: NOT IMPLEMENTED in HybridCache 10.x",
      "originalText": "⚠ Multi-replica L1 invalidation: NOT IMPLEMENTED in HybridCache 10.x",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#7f1d1d", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400003, "version": 1, "versionNonce": 400004,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "caveat", "lineHeight": 1.25
    },
    {
      "type": "text", "id": "caveat_body", "x": 780, "y": 760, "width": 660, "height": 130,
      "text": "Microsoft.Extensions.Caching.Hybrid 10.x has NO backplane. RemoveByTagAsync clears L2 + the calling replica's L1 — but other replicas keep serving stale L1 for the full LocalCacheExpiration (5 min).\n\nFINE TODAY: we run single-replica via Aspire.\n\nWHEN WE GO MULTI-REPLICA:\n   1. Cheap fix: drop LocalCacheExpiration to 60s (one-line) → bounded staleness.\n   2. Real fix: migrate to FusionCache — ships a Redis pub/sub backplane that notifies all replicas to clear L1. Tracked in STATUS.md.",
      "originalText": "Microsoft.Extensions.Caching.Hybrid 10.x has NO backplane. RemoveByTagAsync clears L2 + the calling replica's L1 — but other replicas keep serving stale L1 for the full LocalCacheExpiration (5 min).\n\nFINE TODAY: we run single-replica via Aspire.\n\nWHEN WE GO MULTI-REPLICA:\n   1. Cheap fix: drop LocalCacheExpiration to 60s (one-line) → bounded staleness.\n   2. Real fix: migrate to FusionCache — ships a Redis pub/sub backplane that notifies all replicas to clear L1. Tracked in STATUS.md.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400005, "version": 1, "versionNonce": 400006,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },

    {
      "type": "rectangle", "id": "config", "x": 60, "y": 970, "width": 1400, "height": 110,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500001, "version": 1, "versionNonce": 500002,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"config_t","type":"text"}], "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "config_t", "x": 75, "y": 985, "width": 1370, "height": 90,
      "text": "// HybridProductCache.cs — the actual implementation\nprivate static readonly HybridCacheEntryOptions Options = new() { Expiration = TimeSpan.FromMinutes(5), LocalCacheExpiration = TimeSpan.FromMinutes(5) };\nprivate static string KeyFor(Guid productId) => $\"catalog:product:{productId:N}\";\nprivate static string TagFor(Guid productId) => $\"product:{productId:N}\";\npublic Task<ProductDto?> GetOrLoadAsync(Guid id, Func<CancellationToken, Task<ProductDto?>> factory, CancellationToken ct = default)\n   => cache.GetOrCreateAsync(KeyFor(id), async cancel => await factory(cancel), options: Options, tags: [TagFor(id)], cancellationToken: ct).AsTask();",
      "originalText": "// HybridProductCache.cs — the actual implementation\nprivate static readonly HybridCacheEntryOptions Options = new() { Expiration = TimeSpan.FromMinutes(5), LocalCacheExpiration = TimeSpan.FromMinutes(5) };\nprivate static string KeyFor(Guid productId) => $\"catalog:product:{productId:N}\";\nprivate static string TagFor(Guid productId) => $\"product:{productId:N}\";\npublic Task<ProductDto?> GetOrLoadAsync(Guid id, Func<CancellationToken, Task<ProductDto?>> factory, CancellationToken ct = default)\n   => cache.GetOrCreateAsync(KeyFor(id), async cancel => await factory(cancel), options: Options, tags: [TagFor(id)], cancellationToken: ct).AsTask();",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500003, "version": 1, "versionNonce": 500004,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    }
