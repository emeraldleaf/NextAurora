    {
      "type": "text", "id": "d3_t", "x": 50, "y": 440, "width": 680, "height": 80,
      "text": "3.  EF CLI uses IDesignTimeDbContextFactory to construct the DbContext OUTSIDE the running app.\n     CatalogDbContextFactory.CreateDbContext():\n        reads ConnectionStrings__catalog-db from env (Aspire injects this)\n        falls back to localhost dev string if env not set\n        returns new CatalogDbContext(options) — same context the app uses",
      "originalText": "3.  EF CLI uses IDesignTimeDbContextFactory to construct the DbContext OUTSIDE the running app.\n     CatalogDbContextFactory.CreateDbContext():\n        reads ConnectionStrings__catalog-db from env (Aspire injects this)\n        falls back to localhost dev string if env not set\n        returns new CatalogDbContext(options) — same context the app uses",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200017, "version": 1, "versionNonce": 200018,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "d3", "lineHeight": 1.3
    },

    {
