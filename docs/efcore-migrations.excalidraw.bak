    {
      "type": "rectangle", "id": "d5", "x": 40, "y": 718, "width": 700, "height": 130,
      "strokeColor": "#047857", "backgroundColor": "#a7f3d0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200027, "version": 1, "versionNonce": 200028,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"d5_t","type":"text"}], "link": null, "locked": false, "roundness": {"type": 3}
