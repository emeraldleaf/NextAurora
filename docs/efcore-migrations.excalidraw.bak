    {
      "type": "rectangle", "id": "d4", "x": 40, "y": 566, "width": 700, "height": 120,
      "strokeColor": "#1e3a5f", "backgroundColor": "#dbeafe",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200021, "version": 1, "versionNonce": 200022,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id":"d4_t","type":"text"},{"id":"a_d4","type":"arrow"}], "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "d4_t", "x": 50, "y": 580, "width": 680, "height": 90,
      "text": "4.  EF diffs current model against ModelSnapshot.cs (the last-committed model state) and emits:\n     • {timestamp}_AddPromotionCodes.cs       — Up()/Down() with provider-specific SQL fragments\n     • {timestamp}_AddPromotionCodes.Designer.cs — frozen model snapshot at this migration\n     • CatalogDbContextModelSnapshot.cs        — updated live snapshot for the next diff\n     All three are added to git so the model history is reproducible.",
      "originalText": "4.  EF diffs current model against ModelSnapshot.cs (the last-committed model state) and emits:\n     • {timestamp}_AddPromotionCodes.cs       — Up()/Down() with provider-specific SQL fragments\n     • {timestamp}_AddPromotionCodes.Designer.cs — frozen model snapshot at this migration\n     • CatalogDbContextModelSnapshot.cs        — updated live snapshot for the next diff\n     All three are added to git so the model history is reproducible.",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200023, "version": 1, "versionNonce": 200024,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "d4", "lineHeight": 1.3
    },

    {
      "type": "arrow", "id": "a_d4", "x": 390, "y": 688, "width": 0, "height": 28,
      "strokeColor": "#1e3a5f", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200025, "version": 1, "versionNonce": 200026,
