    {"type":"text","id":"sf_r_6d","x":820,"y":1756,"width":380,"height":20,"text":"Set a budget + stop-time. Default = stop.","originalText":"Set a budget + stop-time. Default = stop.","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#9a3412","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":600050,"version":1,"versionNonce":600051,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
