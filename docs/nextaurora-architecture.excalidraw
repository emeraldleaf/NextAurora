    },
    {
      "id": "payment_svc_title",
      "type": "text",
      "x": 955, "y": 300,
      "width": 320, "height": 28,
      "text": "PaymentService",
      "originalText": "PaymentService",
      "fontSize": 19, "fontFamily": 3,
      "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#ffffff", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500015, "version": 1, "versionNonce": 500016,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "id": "payment_svc_body",
      "type": "text",
      "x": 955, "y": 335,
      "width": 320, "height": 165,
      "text": "SQL Server + Wolverine outbox\n──────────────────────\nREST  POST /api/v1/payments/process (admin)\nUNIQUE INDEX on OrderId  (db backstop)\n\nOrderPlacedHandler  (cascade msg)\n  →  ProcessPaymentCommand\n  →  Stripe gateway (anti-corruption)\n  →  Mark Completed/Failed\n  →  Publish PaymentCompleted /\n      PaymentFailedEvent",
      "originalText": "SQL Server + Wolverine outbox\n──────────────────────\nREST  POST /api/v1/payments/process (admin)\nUNIQUE INDEX on OrderId  (db backstop)\n\nOrderPlacedHandler  (cascade msg)\n  →  ProcessPaymentCommand\n  →  Stripe gateway (anti-corruption)\n  →  Mark Completed/Failed\n  →  Publish PaymentCompleted /\n      PaymentFailedEvent",
      "fontSize": 12, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#ffffff", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500017, "version": 1, "versionNonce": 500018,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },
