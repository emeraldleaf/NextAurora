    {
      "id": "order_svc_body",
      "type": "text",
      "x": 590,
      "y": 335,
      "width": 316.40625,
      "height": 171.60000000000002,
      "text": "SQL Server + Wolverine outbox\n──────────────────────\nREST  POST /api/v1/orders        (saga entry)\nREST  GET  /api/v1/orders/{id}\nREST  GET  /api/v1/orders/buyer/{buyerId}\nbuyerId must match JWT sub  → 403\n\nPlaceOrder  →  gRPC validate + reserve\n  on Catalog →  Order.Create →\n  AddAsync + PublishAsync  (one tx)\nReacts: PaymentCompleted, ShipmentDispatched",
      "originalText": "SQL Server + Wolverine outbox\n──────────────────────\nREST  POST /api/v1/orders        (saga entry)\nREST  GET  /api/v1/orders/{id}\nREST  GET  /api/v1/orders/buyer/{buyerId}\nbuyerId must match JWT sub  → 403\n\nPlaceOrder  →  gRPC validate + reserve\n  on Catalog →  Order.Create →\n  AddAsync + PublishAsync  (one tx)\nReacts: PaymentCompleted, ShipmentDispatched",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 500011,
      "version": 3,
      "versionNonce": 1590054701,
      "isDeleted": false,
