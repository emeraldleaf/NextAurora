    {
      "id": "saga_panel_title",
      "type": "text",
      "x": 215,
      "y": 1080,
      "width": 1780,
      "height": 30,
      "text": "Order placement saga  ·  end-to-end walk",
      "originalText": "Order placement saga  ·  end-to-end walk",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 900001,
      "version": 2,
      "versionNonce": 1899087011,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
