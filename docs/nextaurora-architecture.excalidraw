      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "id": "catalog_svc_body",
      "type": "text",
      "x": 225, "y": 335,
      "width": 320, "height": 165,
      "text": "Postgres + Redis + gRPC server\n──────────────────────\nREST  /api/v1/products  (paginated)\nREST  /api/v1/products/search  (rate-limited)\nREST  POST/PUT  (seller-only, JWT)\ngRPC  GetProduct, ReserveStock\n\nHandlers: Create / Update / GetById /\n  GetAll / Search / ReserveStock\nIProductCache  (cache-aside on GetById)",
      "originalText": "Postgres + Redis + gRPC server\n──────────────────────\nREST  /api/v1/products  (paginated)\nREST  /api/v1/products/search  (rate-limited)\nREST  POST/PUT  (seller-only, JWT)\ngRPC  GetProduct, ReserveStock\n\nHandlers: Create / Update / GetById /\n  GetAll / Search / ReserveStock\nIProductCache  (cache-aside on GetById)",
      "fontSize": 12, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#ffffff", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500005, "version": 1, "versionNonce": 500006,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },
    {
