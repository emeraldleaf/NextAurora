    {
      "type": "text",
      "id": "history_t",
      "x": 45,
      "y": 1155,
      "width": 741.2109375,
      "height": 157.3,
      "text": "// What lives in each service's Migrations/ folder (committed to git)\n//   Catalog:  CatalogService/CatalogService.Infrastructure/Migrations/\n//   Others:   {Service}/Infrastructure/Migrations/\n\n20260503040949_InitialCreate.cs              -- the migration class with Up() + Down() methods\n20260503040949_InitialCreate.Designer.cs     -- snapshot of the model AT this migration (immutable once applied)\nCatalogDbContextModelSnapshot.cs             -- LIVE snapshot of the current model (regenerated each migration add)\n\n// And in the DB:\nCREATE TABLE __EFMigrationsHistory ( MigrationId nvarchar(150) PK, ProductVersion nvarchar(32) );\n-- Each Migrate() call: read this table, find unapplied entries, run their Up(), INSERT into this table.",
      "originalText": "// What lives in each service's Migrations/ folder (committed to git)\n//   Catalog:  CatalogService/CatalogService.Infrastructure/Migrations/\n//   Others:   {Service}/Infrastructure/Migrations/\n\n20260503040949_InitialCreate.cs              -- the migration class with Up() + Down() methods\n20260503040949_InitialCreate.Designer.cs     -- snapshot of the model AT this migration (immutable once applied)\nCatalogDbContextModelSnapshot.cs             -- LIVE snapshot of the current model (regenerated each migration add)\n\n// And in the DB:\nCREATE TABLE __EFMigrationsHistory ( MigrationId nvarchar(150) PK, ProductVersion nvarchar(32) );\n-- Each Migrate() call: read this table, find unapplied entries, run their Up(), INSERT into this table.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
