    {
      "type": "text", "id": "step3_t", "x": 70, "y": 555, "width": 300, "height": 80,
      "text": "3.  INSERT INTO wolverine.outgoing_envelopes\n      (id, message_type, body, destination, ...)\n    VALUES (...);\n    -- same DB transaction as step 1",
