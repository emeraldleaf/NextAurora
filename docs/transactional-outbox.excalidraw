    {
      "type": "text",
      "id": "failure_title",
      "x": 35,
      "y": 762,
      "width": 253.125,
      "height": 20,
      "text": "Failure modes — all handled",
      "originalText": "Failure modes — all handled",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#7f1d1d",
      "backgroundColor": "transparent",
