    {
      "type": "text",
      "id": "config_t",
      "x": 35,
      "y": 1126,
      "width": 760.546875,
      "height": 114.4,
      "text": "// each service's Api/Program.cs — the configuration that makes it work\nbuilder.Host.UseWolverine(opts => {\n    opts.PersistMessagesWithSqlServer(connStr, \"wolverine\");      // or .PersistMessagesWithPostgresql for Shipping\n    opts.UseEntityFrameworkCoreTransactions();                    // bridge to EF's tx\n    opts.Policies.AutoApplyTransactions();                        // wrap handlers in EF tx\n    opts.Policies.UseDurableOutboxOnAllSendingEndpoints();        // stage outgoing into wolverine.outgoing_envelopes\n});\nbuilder.Services.AddResourceSetupOnStartup();                     // auto-create wolverine schema + tables on app boot",
      "originalText": "// each service's Api/Program.cs — the configuration that makes it work\nbuilder.Host.UseWolverine(opts => {\n    opts.PersistMessagesWithSqlServer(connStr, \"wolverine\");      // or .PersistMessagesWithPostgresql for Shipping\n    opts.UseEntityFrameworkCoreTransactions();                    // bridge to EF's tx\n    opts.Policies.AutoApplyTransactions();                        // wrap handlers in EF tx\n    opts.Policies.UseDurableOutboxOnAllSendingEndpoints();        // stage outgoing into wolverine.outgoing_envelopes\n});\nbuilder.Services.AddResourceSetupOnStartup();                     // auto-create wolverine schema + tables on app boot",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
