    {
      "type": "text", "id": "step1_t", "x": 70, "y": 335, "width": 300, "height": 50,
      "text": "1.  await orderRepository.AddAsync(order)\n   → ctx.Orders.Add(order) → SaveChangesAsync\n   → INSERT INTO Orders ...",
      "originalText": "1.  await orderRepository.AddAsync(order)\n   → ctx.Orders.Add(order) → SaveChangesAsync\n   → INSERT INTO Orders ...",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#ffffff", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300007, "version": 1, "versionNonce": 300008,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "step1", "lineHeight": 1.3
    },
    {
      "type": "text", "id": "ann_step1", "x": 400, "y": 330, "width": 340, "height": 70,
      "text": "Repository writes the entity. EF Core executes the INSERT against the open transaction — not committed yet. The change tracker marks the entity as Unchanged after the write.",
      "originalText": "Repository writes the entity. EF Core executes the INSERT against the open transaction — not committed yet. The change tracker marks the entity as Unchanged after the write.",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300009, "version": 1, "versionNonce": 300010,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },

