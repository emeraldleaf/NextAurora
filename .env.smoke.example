# Copy to .env.smoke and fill in URLs from the Aspire dashboard after `dotnet run --project NextAurora.AppHost`.
# `.env.smoke` is gitignored. The smoke-test script auto-sources this file if present.

# From Aspire dashboard → Resources tab → click on each service to see endpoints.
KEYCLOAK_URL=http://localhost:CHANGEME
CATALOG_URL=https://localhost:CHANGEME
ORDER_URL=https://localhost:CHANGEME

# Optional. Set after creating a product (POST /api/v1/products with seller token) so the
# order-placement step can run. Without these, that step is skipped.
# PRODUCT_ID=00000000-0000-0000-0000-000000000000
# CATEGORY_ID=00000000-0000-0000-0000-000000000000
