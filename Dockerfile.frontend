# Storefront (Vite SPA) — static build served by nginx.
# Build:   docker build -f Dockerfile.frontend --build-arg VITE_CATALOG_API_URL=... -t storefront .
#
# Vite inlines VITE_* at build time (frontend/CLAUDE.md "Security" — public config only),
# so the deployed hostnames are build args, not runtime env. publish-images.yml passes the
# emeraldleaf.dev values; a different deployment rebuilds with its own.
FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG VITE_CATALOG_API_URL
ARG VITE_ORDER_API_URL
ARG VITE_PAYMENT_API_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM=nextaurora
ARG VITE_KEYCLOAK_CLIENT_ID=storefront
ARG VITE_TURNSTILE_SITE_KEY
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
