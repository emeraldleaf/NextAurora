<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- BenchmarkDotNet only produces accurate numbers in Release. -->
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <!-- Suppress analyzer noise on benchmark code; benchmarks intentionally do "weird"
         things (allocation, repeated work) the static analyzers would flag. -->
    <RunAnalyzers>false</RunAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the projects whose code we want to benchmark. Add more as benchmarks grow. -->
    <ProjectReference Include="../../OrderService/OrderService.Domain/OrderService.Domain.csproj" />
  </ItemGroup>
</Project>
