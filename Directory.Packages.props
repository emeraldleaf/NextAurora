<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire Hosting: must match the SDK in NextAurora.AppHost.csproj exactly (or SDK ≥ packages),
         including minor. Major mismatch surfaces at startup as TypeLoadException; minor mismatch
         surfaces as DCP rejecting startup. Bump SDK and packages together. See CLAUDE.md. -->
    <!-- Direct pin of a transitive dep: StreamJsonRpc (via the Aspire AppHost SDK) pulls
         MessagePack 2.5.192, which has a known high-severity advisory (GHSA-hv8m-jj95-wg3x)
         that fails restore under NuGetAudit + TreatWarningsAsErrors (NU1903). Referenced
         directly in NextAurora.AppHost.csproj to force the patched version. Remove when
         StreamJsonRpc ships with MessagePack >= 2.5.301. -->
    <PackageVersion Include="MessagePack" Version="2.5.301" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.4.6" />

    <!-- Web -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Direct pin of a transitive dep: Microsoft.AspNetCore.OpenApi declares Microsoft.OpenApi
         >= 2.0.0, which has a known high-severity advisory (GHSA-v5pm-xwqc-g5wc, circular schema
         references terminate parsing) that fails restore under NuGetAudit + TreatWarningsAsErrors
         (NU1903). First patched version is 2.7.5. Referenced directly in each csproj that pulls
         Microsoft.AspNetCore.OpenApi (same mechanism as the MessagePack pin above — no
         CentralPackageTransitivePinningEnabled in this repo). Remove when
         Microsoft.AspNetCore.OpenApi declares Microsoft.OpenApi >= 2.7.5. See CLAUDE.md. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.14.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />

    <!-- Messaging -->
    <PackageVersion Include="WolverineFx" Version="6.21.0" />
    <!-- Wolverine 6 split the runtime Roslyn code generator out of core (GH-2876). Without it,
         the host throws at startup in the default TypeLoadMode.Dynamic. This package auto-registers
         the IAssemblyGenerator when referenced, restoring 5.x behavior. Referenced from
         ServiceDefaults so it flows to every Wolverine service. Production alternative: pre-generated
         static codegen (TypeLoadMode.Static) — deferred. See https://wolverinefx.net/guide/codegen.html. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.21.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.21.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.21.0" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.21.0" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.21.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.21.0" />

    <!-- Entity Framework -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.79" />

    <!-- Caching -->
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />

    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="DistributedLock.SqlServer" Version="1.0.7" />

    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />

    <!-- gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.29.3" />
    <PackageVersion Include="Grpc.Tools" Version="2.82.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.10.0-beta.1" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Identity -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Keycloak.AuthServices.Aspire.Hosting" Version="0.3.0" />

    <!-- Code Analysis -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.98" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.27.0.140913" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" />

    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
